# Deliberately independent of Qt and the legacy sidecar's private include tree.
set(KROK_SKIA_GPU_API "none" CACHE STRING "none, vulkan, or metal")
set_property(CACHE KROK_SKIA_GPU_API PROPERTY STRINGS none vulkan metal)
foreach(required KROK_SKIA_SOURCE KROK_SKIA_LIB_DIR KROK_SKIA_FINGERPRINT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required; use scripts/build_skia_renderer.py")
    endif()
endforeach()
if(NOT KROK_SKIA_GPU_API MATCHES "^(none|vulkan|metal)$")
    message(FATAL_ERROR "Unknown KROK_SKIA_GPU_API")
endif()

if((APPLE AND KROK_SKIA_GPU_API STREQUAL "vulkan") OR
   (NOT APPLE AND KROK_SKIA_GPU_API STREQUAL "metal"))
    message(FATAL_ERROR "Windows/Linux require native Vulkan; macOS requires native Metal")
endif()
if(MSVC)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
    add_compile_options(/utf-8 /EHsc)
endif()

# These complete_static_lib archives include their own pinned codec/font dependencies.
# Never glob *.lib: unrelated GN test libraries must not enter the product link.
foreach(library skia skshaper skunicode_core skunicode_icu)
    add_library(krok_${library} STATIC IMPORTED)
    set(archive "${KROK_SKIA_LIB_DIR}/${CMAKE_STATIC_LIBRARY_PREFIX}${library}${CMAKE_STATIC_LIBRARY_SUFFIX}")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Missing pinned Skia archive: ${archive}")
    endif()
    set_target_properties(krok_${library} PROPERTIES IMPORTED_LOCATION "${archive}")
endforeach()
add_library(subtitle_skia_core STATIC src/skia/core/validation_scene.cpp src/skia/core/motion_probe.cpp)
target_include_directories(subtitle_skia_core PUBLIC src/skia "${KROK_SKIA_SOURCE}")
target_link_libraries(subtitle_skia_core PUBLIC krok_skia subtitle_scene)
target_compile_definitions(subtitle_skia_core PUBLIC SK_RELEASE)
krok_strict_float(subtitle_skia_core)
if(WIN32)
    target_link_libraries(subtitle_skia_core PUBLIC ole32 uuid)
elseif(APPLE)
    target_link_libraries(subtitle_skia_core PUBLIC "-framework CoreFoundation" "-framework CoreGraphics")
else()
    find_package(Threads REQUIRED)
    target_link_libraries(subtitle_skia_core PUBLIC Threads::Threads ${CMAKE_DL_LIBS})
endif()

add_library(subtitle_skia_raster STATIC src/skia/raster/raster_surface.cpp)
target_link_libraries(subtitle_skia_raster PUBLIC subtitle_skia_core)
krok_strict_float(subtitle_skia_raster)
add_executable(krok_skia_raster_smoke src/skia/validation/smoke_main.cpp src/skia/validation/artifacts.cpp)
target_link_libraries(krok_skia_raster_smoke PRIVATE subtitle_skia_raster)
target_compile_definitions(krok_skia_raster_smoke PRIVATE KROK_SKIA_FINGERPRINT="${KROK_SKIA_FINGERPRINT}")

if(NOT KROK_SKIA_GPU_API STREQUAL "none")
    add_library(subtitle_skia_gpu STATIC src/skia/gpu/gpu_surface.cpp)
    target_link_libraries(subtitle_skia_gpu PUBLIC subtitle_skia_core)
    target_compile_definitions(subtitle_skia_gpu PUBLIC SK_GANESH)
    krok_strict_float(subtitle_skia_gpu)
    if(KROK_SKIA_GPU_API STREQUAL "vulkan")
        target_sources(subtitle_skia_gpu PRIVATE src/skia/gpu/vulkan_session.cpp src/skia/gpu/vulkan_loader.cpp
                       src/skia/gpu/vulkan_borrowed.cpp)
        # Public: vulkan_borrowed.h exposes Vulkan handle types to the host bridge, and nobody
        # may link the loader statically (it is opened at run time or provided by the host).
        target_include_directories(subtitle_skia_gpu PUBLIC "${KROK_SKIA_SOURCE}/third_party/externals/vulkan-headers/include")
        target_compile_definitions(subtitle_skia_gpu PUBLIC VK_NO_PROTOTYPES PRIVATE SK_VULKAN)
    else()
        enable_language(OBJCXX)
        target_sources(subtitle_skia_gpu PRIVATE src/skia/gpu/metal_session.mm src/skia/gpu/metal_borrowed.mm)
        target_compile_options(subtitle_skia_gpu PRIVATE "$<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>")
        target_link_libraries(subtitle_skia_gpu PRIVATE "-framework Metal" "-framework Foundation")
        # Positive control proving MTL_DEBUG_LAYER is really active in a test environment.
        add_executable(krok_metal_validation_probe src/skia/validation/metal_validation_probe.mm)
        target_compile_options(krok_metal_validation_probe PRIVATE -fobjc-arc)
        target_link_libraries(krok_metal_validation_probe PRIVATE "-framework Metal" "-framework Foundation")
    endif()
    add_executable(krok_skia_gpu_smoke src/skia/validation/smoke_main.cpp src/skia/validation/artifacts.cpp)
    target_compile_definitions(krok_skia_gpu_smoke PRIVATE KROK_SKIA_GPU_SMOKE KROK_SKIA_FINGERPRINT="${KROK_SKIA_FINGERPRINT}")
    target_link_libraries(krok_skia_gpu_smoke PRIVATE subtitle_skia_gpu)
endif()

add_library(subtitle_skia_backend STATIC src/backends/skia/skia_backend.cpp)
target_link_libraries(subtitle_skia_backend PUBLIC subtitle_skia_raster subtitle_session_runtime)
krok_strict_float(subtitle_skia_backend)
if(TARGET subtitle_skia_gpu)
    target_link_libraries(subtitle_skia_backend PUBLIC subtitle_skia_gpu)
    target_compile_definitions(subtitle_skia_backend PRIVATE KROK_SKIA_GPU_ENABLED)
endif()
if(KROK_BUILD_NATIVE_TESTS)
    add_executable(subtitle_skia_backend_tests tests/skia_backend_tests.cpp)
    target_link_libraries(subtitle_skia_backend_tests PRIVATE subtitle_skia_backend)
    add_test(NAME subtitle_skia_backend_tests COMMAND subtitle_skia_backend_tests)
    set_tests_properties(subtitle_skia_backend_tests PROPERTIES TIMEOUT 60)
endif()
